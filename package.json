{
  "name": "veloide",
  "private": true,
  "version": "1.0.0",
  "description": "Ultra-fast, free, local-first ziptie IDE based on VeloWrite — open any file, press Run, and any compiler installs on demand. Includes local Qwen2.5-Coder-1.5B autocomplete and standalone Portable mode.",
  "author": "halxo <halxo@users.noreply.github.com>",
  "homepage": "https://github.com/halxo/veloide",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/halxo/veloide.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "verify:registry": "node scripts/verify-registry.mjs",
    "electron:start": "electron .",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:win:portable": "npm run build && electron-builder --win dir --x64 && node scripts/build-portable.mjs win",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --x64",
    "dist:linux:portable": "npm run build && electron-builder --linux dir --x64 && node scripts/build-portable.mjs linux",
    "dist:mac": "npm run build && electron-builder --mac dmg --arm64 --x64",
    "dist:mac:portable": "npm run build && electron-builder --mac dir --arm64 && node scripts/build-portable.mjs mac"
  },
  "build": {
    "appId": "com.halxo.veloide",
    "productName": "VeloIde",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "registry/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "VeloIde-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VeloIde",
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "maintainer": "halxo <halxo@users.noreply.github.com>",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "artifactName": "VeloIde-${version}-linux-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "artifactName": "VeloIde-${version}-mac-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "halxo",
        "repo": "veloide",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.3",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.8.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/language": "^6.11.0",
    "@codemirror/legacy-modes": "^6.5.1",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@lezer/highlight": "^1.2.1",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "marked": "^15.0.7",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
